# Turso Database (required for Vercel, optional for local dev)
# Local dev uses a SQLite file by default if these are not set.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# LLM Provider API Keys
# Set the keys for the providers you want to use.
# Only the active provider's key is used at any given time.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: override the default model per provider
# ANTHROPIC_MODEL=claude-sonnet-4-5-20241022
# OPENAI_MODEL=gpt-4o
# GOOGLE_MODEL=gemini-1.5-pro

# Authentication (required)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random 32+ character string for signing sessions
BETTER_AUTH_SECRET=

# App URL (http://localhost:3001 for dev, your Vercel URL for prod)
BETTER_AUTH_URL=http://localhost:3001

# Your email — gets admin access + first entry in allowlist
ADMIN_EMAIL=

# Additional emails to allowlist on startup (comma-separated)
# ALLOWLIST_EMAILS=user1@example.com,user2@example.com

# Frontend needs this to show the Admin nav link
VITE_ADMIN_EMAIL=
